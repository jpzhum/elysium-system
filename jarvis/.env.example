# Valores fictícios. Copie para jarvis/.env localmente e substitua tudo.
# No Render, use Environment; nunca envie segredos em chat ou ao Git.
JARVIS_DISCORD_TOKEN=replace-with-separate-jarvis-bot-token
JARVIS_OWNER_USER_ID=100000000000000001
JARVIS_GUILD_ID=100000000000000002
ELEVENLABS_AGENT_ID=replace-with-private-agent-id
ELEVENLABS_API_KEY=replace-with-dedicated-elevenlabs-api-key
# true exige Security > First message override no agente ElevenLabs.
# false somente quando First message já está vazio no agente publicado.
JARVIS_SUPPRESS_FIRST_MESSAGE=true

# Sem conexão automática. Se preenchido, limita /join a este canal.
JARVIS_DEFAULT_VOICE_CHANNEL_ID=
# disabled = somente /ask; elevenlabs-stt = wake experimental com envio pré-ativação.
JARVIS_VOICE_INPUT=disabled
# Experimental, somente proprietário com consentimento de áudio. Comece false.
JARVIS_BARGE_IN_ENABLED=false
JARVIS_WAKE_WORD=Jarvis
JARVIS_FOLLOWUP_SECONDS=18
JARVIS_MAX_ACTIVE_SESSIONS=2
JARVIS_MAX_QUEUED_TURNS=8
JARVIS_MAX_QUEUED_PER_USER=2
JARVIS_QUESTION_QUEUE_TTL_SECONDS=60
JARVIS_SESSION_IDLE_SECONDS=45
# Contexto curto em RAM, por chamada e falante; 0 desabilita. Não é memória durável.
JARVIS_SHORT_MEMORY_TTL_SECONDS=600
JARVIS_MAX_AUDIO_SECONDS_PER_TURN=12
JARVIS_MAX_SESSION_SECONDS=300
JARVIS_MAX_TURNS_PER_HOUR=120
JARVIS_MAX_WAKE_CHECKS_PER_MINUTE=6
# Opcional: somente Brave Web Search; sem chave, nenhuma busca é feita.
JARVIS_SEARCH_API_KEY=
JARVIS_LOG_LEVEL=info
