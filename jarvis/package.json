{
  "name": "elysium-jarvis-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "smoke:dave": "node --enable-source-maps dist/index.js --dave-smoke",
    "audit:agent": "node --enable-source-maps dist/audit-agent.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "opusscript": "0.1.1",
    "ws": "8.22.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
